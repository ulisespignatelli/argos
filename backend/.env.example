# Copiá este archivo como .env (en la carpeta backend) y completá lo que necesites.
# El .env está en .gitignore: nunca se sube a GitHub.

# live = fuentes reales, demo = datos simulados (sin red ni claves)
ARGOS_MODE=live

# abuse.ch (ThreatFox y URLhaus): una sola clave gratuita en https://auth.abuse.ch
ARGOS_ABUSECH_KEY=
# Días hacia atrás de indicadores de ThreatFox (1 a 7)
ARGOS_THREATFOX_DAYS=3

# Países a vigilar (códigos de 2 letras separados por coma): alerta si aparece un C2 nuevo allí
ARGOS_WATCH_COUNTRIES=AR

# Geolocalización de IPs: ip-api (gratis, sin clave, uso no comercial) o none
ARGOS_GEOIP=ip-api

# Cada cuánto se consulta cada fuente, en segundos
ARGOS_THREATFOX_INTERVAL=900
ARGOS_URLHAUS_INTERVAL=900
ARGOS_KEV_INTERVAL=21600

# Consultas por minuto permitidas por cliente a la API
ARGOS_RATE_LIMIT=240
# Días de historial que se conservan (ventanas 7D a 1A)
ARGOS_HISTORY_DAYS=365

# Víctimas de ransomware (ransomware.live, sin clave): cada cuánto se consulta, en segundos
ARGOS_RANSOMWARE_INTERVAL=1800

# Noticias y avisos oficiales (RSS, sin clave ni IA): cada cuánto se leen, en segundos (0 = desactivado)
ARGOS_NEWS_INTERVAL=1800
# Días hacia atrás que se consideran
ARGOS_NEWS_DAYS=14
# Feeds propios (reemplazan la lista por defecto): Nombre|https://url|oficial;Otro|https://url
# ARGOS_NEWS_FEEDS=
